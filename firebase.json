{
  "hosting": {
    "site": "go-documentacao",
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/doc/",
        "type": 302
      },
      {
        "regex": "^/(pkg|cmd|blog|dl|learn|solutions|wiki|help|talks|security|ref|tour|play|project|s|tos|conduct|copyright|brand|gopls|issue|cl|design|change|search|mod|x|testimonials|about)(/.*)?$",
        "destination": "https://go.dev/:1:2",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|svg|png|jpg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
